{
  "logo": { "type": "none" },
  "display": { "separator": "  ", "color": { "keys": "white", "title": "white" } },
  "modules": [
    { "type": "os",       "key": "os   " },
    { "type": "kernel",   "key": "krnl " },
    { "type": "uptime",   "key": "up   " },
    { "type": "packages", "key": "pkgs ", "format": "{pacman} (pacman)" },
